@model TechStore.Models.Producto
@{
    string badgeClase = Model.Estado switch
    {
        "Activo" => "badge-activo",
        "Nuevo" => "badge-nuevo",
        "Oferta" => "badge-oferta",
        "Agotado" => "badge-agotado",
        _ => "badge-activo"
    };
}

<div class="card tech-card">
    @if (!string.IsNullOrWhiteSpace(Model.Imagen))
    {
        <img src="~/images/@Model.Imagen" class="card-img-top" alt="@Model.Nombre" />
    }
    else
    {
        <div class="tarjeta-sin-imagen">
            <i class="bi bi-image"></i>
        </div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge @badgeClase">@Model.Estado</span>
            <small class="text-muted">@Model.Categoria?.Nombre</small>
        </div>
        <h5 class="card-title">@Model.Nombre</h5>
        <p class="card-text flex-grow-1">@Model.Descripcion</p>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="precio">$@Model.Precio.ToString("N2")</span>
            <small class="text-muted">Stock: @Model.Stock</small>
        </div>
    </div>
</div>
