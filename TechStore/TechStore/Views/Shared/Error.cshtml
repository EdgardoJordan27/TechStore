@model ErrorViewModel
@{
    var noEncontrado = Model.Codigo == 404;
    ViewData["Title"] = noEncontrado ? "Página no encontrada" : "Error";
}

<div class="container panel-admin panel-estrecho">
    <div class="pagina-estado">
        <i class="bi @(noEncontrado ? "bi-search" : "bi-exclamation-triangle") pagina-estado-icono"></i>
        <p class="pagina-estado-codigo">@Model.Codigo</p>

        @if (noEncontrado)
        {
            <h1 class="panel-titulo">Página no encontrada</h1>
            <p class="panel-subtitulo">La dirección que intentó abrir no existe o fue movida.</p>
        }
        else
        {
            <h1 class="panel-titulo">Ocurrió un problema</h1>
            <p class="panel-subtitulo">
                No pudimos completar su solicitud. El incidente quedó registrado y puede intentarlo de nuevo en unos minutos.
            </p>
        }

        @if (Model.ShowRequestId)
        {
            <p class="pagina-estado-referencia">Código de referencia: <code>@Model.RequestId</code></p>
        }

        <div class="pagina-estado-acciones">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primario">Volver al inicio</a>
            <a asp-controller="Productos" asp-action="Index" class="btn btn-secundario">Ir a productos</a>
        </div>
    </div>
</div>
