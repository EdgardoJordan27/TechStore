<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechStore.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
        var accionActual = ViewContext.RouteData.Values["action"]?.ToString();

        string EsActivo(string controlador, string accion)
        {
            return controladorActual == controlador && accionActual == accion ? "active" : "";
        }
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-tech sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cpu-fill me-2"></i>Tech<span class="text-cyan">Store</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @EsActivo("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Productos", "Index")" asp-area="" asp-controller="Productos" asp-action="Index">Productos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Categorias", "Index")" asp-area="" asp-controller="Categorias" asp-action="Index">Categorias</a>
                            </li>
                        }
                        @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Vendedor))
                        {
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Reportes", "Index")" asp-area="" asp-controller="Reportes" asp-action="Index">Reportes</a>
                            </li>
                        }
                        @if (User.IsInRole(RolesSistema.Administrador))
                        {
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Usuarios", "Index")" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @EsActivo("Home", "Contacto")" asp-area="" asp-controller="Home" asp-action="Contacto">Contactenos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @EsActivo("Home", "AcercaDe")" asp-area="" asp-controller="Home" asp-action="AcercaDe">Acerca de nosotros</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var rolActual = RolesSistema.Todos.FirstOrDefault(r => User.IsInRole(r)) ?? "Sin rol";
                            <li class="nav-item">
                                <span class="nav-link menu-usuario">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                    <span class="insignia-rol ms-1">@rolActual</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Account", "Login")" asp-area="" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Account", "Register")" asp-area="" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-tech">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h5><i class="bi bi-cpu-fill me-2"></i>TechStore</h5>
                    <p class="text-muted small">Tecnologia de alto rendimiento para gamers, creadores y profesionales.</p>
                </div>
                <div class="col-md-4">
                    <h6>Enlaces</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Productos" asp-action="Index">Productos</a></li>
                        <li><a asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                        <li><a asp-controller="Home" asp-action="AcercaDe">Acerca de nosotros</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Contacto</h6>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-envelope me-2"></i>contacto@techstore.com</li>
                        <li><i class="bi bi-telephone me-2"></i>+503 2200-0000</li>
                        <li><i class="bi bi-geo-alt me-2"></i>San Salvador, El Salvador</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center text-muted small mb-0">&copy; 2026 TechStore. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>