@{
    ViewData["Title"] = "Acerca de nosotros";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1>Acerca de <span class="text-cyan">TechStore</span></h1>
        <p class="text-muted">Conoce quienes somos y que nos mueve.</p>
    </div>

    <section class="mb-5">
        <div class="categoria-card">
            <h5><i class="bi bi-clock-history text-cyan me-2"></i>Nuestra historia</h5>
            <p class="text-muted mb-0">
                TechStore nacio de la idea de ofrecer tecnologia de alto rendimiento a un
                publico que exige calidad real: gamers, creadores de contenido y profesionales
                que dependen de sus equipos para trabajar y competir al maximo nivel. Empezamos
                como un pequeno catalogo curado y hoy seguimos creciendo con la misma filosofia:
                cada producto que vendemos lo probamos y lo recomendamos de verdad.
            </p>
        </div>
    </section>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="categoria-card h-100">
                <i class="bi bi-bullseye categoria-icono"></i>
                <h5 class="mt-3">Mision</h5>
                <p class="text-muted small mb-0">
                    Acercar tecnologia de punta a precios justos, con asesoria honesta y
                    soporte real antes y despues de la compra.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="categoria-card h-100">
                <i class="bi bi-eye categoria-icono"></i>
                <h5 class="mt-3">Vision</h5>
                <p class="text-muted small mb-0">
                    Ser la tienda tech de referencia en El Salvador para gamers y creadores,
                    reconocida por su curaduria de producto y su servicio cercano.
                </p>
            </div>
        </div>
    </div>

    <section>
        <h5 class="text-center mb-4">Nuestros valores</h5>
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <i class="bi bi-shield-check categoria-icono"></i>
                <h6 class="mt-2">Confianza</h6>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-lightning-charge categoria-icono"></i>
                <h6 class="mt-2">Innovacion</h6>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-people categoria-icono"></i>
                <h6 class="mt-2">Cercania</h6>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-award categoria-icono"></i>
                <h6 class="mt-2">Calidad</h6>
            </div>
        </div>
    </section>
</div>
