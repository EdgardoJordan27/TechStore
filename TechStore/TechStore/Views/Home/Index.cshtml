@model List<TechStore.Models.Producto>
@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-tech text-center">
    <div class="container">
        <h1 class="display-4">
            Potencia y estilo en cada <span class="highlight">producto tech</span>
        </h1>
        <p class="text-muted col-md-8 mx-auto mt-3">
            TechStore es tu tienda especializada en tecnologia de alto rendimiento
            para gamers, creadores de contenido y profesionales tech.
        </p>
        <div class="mt-4">
            <a asp-controller="Productos" asp-action="Index" class="btn btn-tech me-2">
                Ver productos
            </a>
            <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-light">
                Explorar categorias
            </a>
        </div>
    </div>
</section>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">Productos destacados</h2>
        <a asp-controller="Productos" asp-action="Index" class="text-cyan small">
            Ver todos <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var producto in Model)
        {
            <div class="col">
                <partial name="_ProductCard" model="producto" />
            </div>
        }
    </div>
</div>

<div class="container mt-5 mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <i class="bi bi-truck categoria-icono"></i>
            <h6 class="mt-2">Envios rapidos</h6>
            <p class="text-muted small">Entregas en todo El Salvador.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-shield-check categoria-icono"></i>
            <h6 class="mt-2">Garantia real</h6>
            <p class="text-muted small">Productos originales y garantizados.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-headset categoria-icono"></i>
            <h6 class="mt-2">Soporte tecnico</h6>
            <p class="text-muted small">Atencion personalizada para gamers y pros.</p>
        </div>
    </div>
</div>
