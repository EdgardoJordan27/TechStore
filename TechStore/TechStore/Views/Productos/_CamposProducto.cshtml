@model ProductoFormViewModel

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="120" autocomplete="off" />
        <span asp-validation-for="Nombre" class="campo-error"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
            <option value="">Seleccione una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="campo-error"></span>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="400"></textarea>
        <span asp-validation-for="Descripcion" class="campo-error"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Precio" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" />
        </div>
        <span asp-validation-for="Precio" class="campo-error"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" type="number" step="1" min="0" class="form-control" />
        <span asp-validation-for="Stock" class="campo-error"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" asp-items="new SelectList(EstadosProducto.Todos)" class="form-select">
            <option value="">Seleccione un estado</option>
        </select>
        <span asp-validation-for="Estado" class="campo-error"></span>
    </div>

    <div class="col-12">
        <label asp-for="Imagen" class="form-label"></label>
        <input asp-for="Imagen" class="form-control" maxlength="200" placeholder="productos/laptop.jpg" autocomplete="off" />
        <span class="ayuda-campo">Opcional. Ruta relativa dentro de wwwroot/images.</span>
        <span asp-validation-for="Imagen" class="campo-error"></span>
    </div>
</div>
