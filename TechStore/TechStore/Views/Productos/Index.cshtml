@model List<TechStore.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    var esAdministrador = User.IsInRole(RolesSistema.Administrador);
    var puedeEditar = esAdministrador || User.IsInRole(RolesSistema.Vendedor);
}

<div class="container panel-admin">
    <div class="panel-cabecera">
        <div>
            <h1 class="panel-titulo">Productos</h1>
            <p class="panel-subtitulo">
                @Model.Count producto@(Model.Count != 1 ? "s" : "") registrado@(Model.Count != 1 ? "s" : "") en el catálogo
            </p>
        </div>
        @if (puedeEditar)
        {
            <div class="acciones-fila">
                <a asp-controller="Reportes" asp-action="Pdf" class="btn btn-secundario">
                    <i class="bi bi-file-earmark-pdf me-1"></i>Reporte PDF
                </a>
                <a asp-controller="Reportes" asp-action="Excel" class="btn btn-secundario">
                    <i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel
                </a>
                <a asp-action="Agregar" class="btn btn-primario">
                    <i class="bi bi-plus-lg me-1"></i>Nuevo producto
                </a>
            </div>
        }
    </div>

    <partial name="_Mensajes" />

    @if (puedeEditar)
    {
        @await Component.InvokeAsync("ResumenInventario")
    }

    @if (!Model.Any())
    {
        <div class="estado-vacio">
            <p class="mb-1">Todavía no hay productos registrados.</p>
            @if (puedeEditar)
            {
                <a asp-action="Agregar" class="text-cyan">Registrar el primero</a>
            }
        </div>
    }
    else
    {
        <div class="tabla-contenedor table-responsive">
            <table class="table tabla-admin align-middle">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Producto</th>
                        <th scope="col">Categoría</th>
                        <th scope="col" class="text-end">Precio</th>
                        <th scope="col" class="text-end">Stock</th>
                        <th scope="col">Estado</th>
                        @if (puedeEditar)
                        {
                            <th scope="col" class="text-end">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in Model)
                    {
                        <tr>
                            <td class="text-muted">@producto.Id</td>
                            <td>
                                <div class="celda-producto">
                                    @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                                    {
                                        <img src="~/images/@producto.Imagen" class="miniatura" alt="@producto.Nombre" />
                                    }
                                    else
                                    {
                                        <span class="miniatura miniatura-vacia"><i class="bi bi-image"></i></span>
                                    }
                                    <div>
                                        <div class="fw-semibold">@producto.Nombre</div>
                                        <div class="descripcion-corta" title="@producto.Descripcion">@producto.Descripcion</div>
                                    </div>
                                </div>
                            </td>
                            <td>@producto.Categoria?.Nombre</td>
                            <td class="text-end">$@producto.Precio.ToString("N2")</td>
                            <td class="text-end @(producto.Stock <= 5 ? "stock-bajo" : "")">@producto.Stock</td>
                            <td><span class="estado estado-@producto.Estado.ToLowerInvariant()">@producto.Estado</span></td>
                            @if (puedeEditar)
                            {
                                <td>
                                    <div class="acciones-fila">
                                        <a asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-secundario btn-fila">Editar</a>
                                        @if (esAdministrador)
                                        {
                                            <a asp-action="Eliminar" asp-route-id="@producto.Id" class="btn btn-secundario btn-fila btn-fila-peligro">Eliminar</a>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
