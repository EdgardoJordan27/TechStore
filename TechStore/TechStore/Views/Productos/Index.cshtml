@model List<TechStore.Models.Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1>Nuestros <span class="text-cyan">productos</span></h1>
        <p class="text-muted">Tecnologia seleccionada para gamers, creadores y profesionales.</p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var producto in Model)
        {
            <div class="col">
                <partial name="_ProductCard" model="producto" />
            </div>
        }
    </div>
</div>
