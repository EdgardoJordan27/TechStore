@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container panel-admin panel-autenticacion">
    <div class="panel-cabecera">
        <div>
            <h1 class="panel-titulo">Iniciar sesión</h1>
            <p class="panel-subtitulo">Ingrese con su cuenta de TechStore.</p>
        </div>
    </div>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="formulario-panel">
        <div asp-validation-summary="ModelOnly" class="aviso aviso-error"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autocomplete="username" />
                <span asp-validation-for="Correo" class="campo-error"></span>
            </div>

            <div class="col-12">
                <label asp-for="Clave" class="form-label"></label>
                <input asp-for="Clave" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Clave" class="campo-error"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="formulario-pie">
            <a asp-action="Register" class="btn btn-secundario">Crear cuenta</a>
            <button type="submit" class="btn btn-primario">Ingresar</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
