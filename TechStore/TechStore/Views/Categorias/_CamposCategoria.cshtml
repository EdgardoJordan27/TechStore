@model CategoriaFormViewModel

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="80" autocomplete="off" />
        <span asp-validation-for="Nombre" class="campo-error"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Icono" class="form-label"></label>
        <select asp-for="Icono" asp-items="new SelectList(IconosCategoria.Disponibles, nameof(OpcionIcono.Clase), nameof(OpcionIcono.Etiqueta))" class="form-select"></select>
        <span asp-validation-for="Icono" class="campo-error"></span>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="300"></textarea>
        <span asp-validation-for="Descripcion" class="campo-error"></span>
    </div>
</div>
