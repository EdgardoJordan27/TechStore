@model List<TechStore.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
    var esAdministrador = User.IsInRole(RolesSistema.Administrador);
}

<div class="container panel-admin">
    <div class="panel-cabecera">
        <div>
            <h1 class="panel-titulo">Categorías</h1>
            <p class="panel-subtitulo">Catálogo organizado por tipo de producto.</p>
        </div>
        @if (esAdministrador)
        {
            <a asp-action="Agregar" class="btn btn-primario">
                <i class="bi bi-plus-lg me-1"></i>Nueva categoría
            </a>
        }
    </div>

    <partial name="_Mensajes" />

    @if (!Model.Any())
    {
        <div class="estado-vacio">
            <p class="mb-1">Todavía no hay categorías registradas.</p>
            @if (esAdministrador)
            {
                <a asp-action="Agregar" class="text-cyan">Registrar la primera</a>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @foreach (var categoria in Model)
            {
                var cantidad = categoria.Productos.Count;
                var precioDesde = cantidad > 0 ? categoria.Productos.Min(p => p.Precio) : 0m;

                <div class="col">
                    <div class="categoria-card d-flex flex-column">
                        <i class="bi @categoria.Icono categoria-icono"></i>
                        <h5 class="mt-3">@categoria.Nombre</h5>
                        <p class="text-muted small flex-grow-1">@categoria.Descripcion</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-secondary">
                                @cantidad producto@(cantidad != 1 ? "s" : "")
                            </span>
                            @if (cantidad > 0)
                            {
                                <span class="text-cyan small">Desde $@precioDesde.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="text-muted small">Sin productos</span>
                            }
                        </div>
                        @if (esAdministrador)
                        {
                            <div class="categoria-acciones">
                                <a asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-secundario btn-fila">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@categoria.Id" class="btn btn-secundario btn-fila btn-fila-peligro">Eliminar</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
