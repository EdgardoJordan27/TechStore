@model List<TechStore.Models.Categoria>
@{
    ViewData["Title"] = "Categorias";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1>Nuestras <span class="text-cyan">categorias</span></h1>
        <p class="text-muted">Explora nuestro catalogo organizado por tipo de producto.</p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var categoria in Model)
        {
            <div class="col">
                <div class="categoria-card">
                    <i class="bi @categoria.Icono categoria-icono"></i>
                    <h5 class="mt-3">@categoria.Nombre</h5>
                    <p class="text-muted small">@categoria.Descripcion</p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="badge bg-secondary">
                            @categoria.CantidadProductos producto@(categoria.CantidadProductos != 1 ? "s" : "")
                        </span>
                        <span class="text-cyan small">Desde $@categoria.PrecioDesde.ToString("N2")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
